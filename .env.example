# AI Model Configuration
# Choose AI provider: 'claude', 'gemini', or 'deepseek' (default: claude)
AI_PROVIDER=deepseek

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=your-api-key-here

# Google Gemini API Key (for Gemini)
GEMINI_API_KEY=AIzaSyA5E1OE_r3Np4_-UmWglFuv2fpIFMqa_Nk

# DeepSeek API Key (for DeepSeek)
DEEPSEEK_API_KEY=sk-bc84730a127243e5aeeecd07ad8d3cc5

# Skip validation step (optional, set to 'true' to skip)
# Useful if LibreOffice/pdftoppm are not installed
SKIP_VALIDATION=false

# Validation concurrency (optional, default: 5)
# Number of slides to validate in parallel during validation stage
# Higher values = faster validation but more API load (recommended: 3-10)
VALIDATION_CONCURRENCY=5

# Maximum fix iterations (optional, default: 3)
MAX_FIX_ITERATIONS=3

# Optional: Additional API Keys for video generation features
DID_API_KEY=your_did_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ============================================
# Vertex AI Imagen Configuration
# ============================================
# Enable AI image generation for slides
IMAGE_GENERATION_ENABLED=false

# Google Cloud Project ID (required for Imagen)
GOOGLE_CLOUD_PROJECT=your-project-id

# Google Cloud Location (default: us-central1)
GOOGLE_CLOUD_LOCATION=us-central1

# Imagen model (default: imagegeneration@006)
IMAGEN_MODEL=imagegeneration@006

# Image cache directory (default: ./output/image-cache)
IMAGE_CACHE_DIR=./output/image-cache

# Image generation style (professional, artistic, photorealistic)
IMAGE_STYLE=professional

# Skip background image generation (default: false)
SKIP_BACKGROUNDS=false
